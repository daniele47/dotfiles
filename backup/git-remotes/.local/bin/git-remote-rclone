#!/bin/bash

# Script to use rclone as a pseudo git remote
#
# How to use:
# - place this script into any directory in PATH
# - indicate the remote as `rclone::<REPO_URL>`
# - now rclone is kinda like a git server!

set -euo pipefail

log() {
    echo -e "\e[1m$*\e[m" >&2
}
warn() {
    log "\e[33mWARNING: $1"
}
error_exit() {
    log "\e[31mERROR: $1"
    exit 1
}
validate_url() {
    local url="$1"
    if [[ "$url" =~ [^a-zA-Z0-9:./_-] ]]; then
        error_exit "URL contains forbidden characters. Allowed: a-z A-Z 0-9 : / - _ ."
    fi
    echo "${REMOTE_URL//\//%}"
    return 0
}

# validate dependencies
for dep in rclone git; do
    if ! command -v "$dep" &>/dev/null; then
        error_exit "Missing required dependency: '$dep'"
    fi
done

REMOTE_URL="$2"
REMOTE_NAME="${REMOTE_URL%%:*}:"
REPO_NAME="$(validate_url "$REMOTE_URL")"
CACHE_TOPDIR="${XDG_CACHE_HOME:-HOME/.cache}/git-remote-rclone"
CACHE_DIR="$CACHE_TOPDIR/$REPO_NAME"

get_rclone_encryption_password() {
    # validate deps
    if ! command -v secret-tool &>/dev/null; then
        echo "WARNING: secret-tool is required to get rclone password!" >&2
        return 1
    fi

    # load or store and load password
    PW="$(secret-tool lookup service rclone item config-pass 2>/dev/null || true)"
    if [[ -z "$PW" ]]; then
        echo -n "rclone config password: " >&2
        IFS= read -rs PW </dev/tty || true
        echo >&2
        echo "$PW" | secret-tool store --label='rclone config password' service rclone item config-pass
    fi

    # output password
    echo "$PW"
}
export -f get_rclone_encryption_password

run_cli() {
    RCLONE_PASSWORD_COMMAND="bash -c get_rclone_encryption_password" rclone --progress "$@" --ask-password=false
}

validate_remote() {
    {
        log "- Validating remote '$REMOTE_NAME' is available..."
        if ! run_cli listremotes -q | grep -Fxq "${REMOTE_NAME}" &>/dev/null; then
            error_exit "Remote isn't avaiable! Try fixing config file!"
        fi
    } >&2
}

upload_repo() {
    {
        log "- Uploading git repo to remote '$REMOTE_URL'..."
        run_cli sync "$CACHE_DIR" "$REMOTE_URL" --exclude '/hooks/**' >&2
    } >&2
}

download_repo() {
    {
        log "- Downloading git repo from '$REMOTE_URL' into '$CACHE_DIR'..."
        if ! run_cli sync "$REMOTE_URL" "$CACHE_DIR" >&2; then
            warn "Failed to download repo: remote path missing or inaccessible!"
            rm -rf "$CACHE_DIR"
            return 1
        fi
    } >&2
}

init_repo() {
    if ! env -u GIT_DIR -u GIT_WORK_TREE git -C "$CACHE_DIR" rev-parse --git-dir &>/dev/null; then
        log "- Missing git repository, initializing one at '$CACHE_DIR'..."
        echo -n "Are you sure you want to create this new repository? [y/n] "
        read -r answer </dev/tty
        if [[ "$answer" != y ]]; then exit 0; fi
        env -u GIT_DIR -u GIT_WORK_TREE git init --bare "$CACHE_DIR"
    fi >&2
}

mkdir -p "$CACHE_TOPDIR"

while IFS= read -r line; do
    case "$line" in
    capabilities)
        echo -e "connect\n"
        ;;
    "connect git-receive-pack"*)
        echo

        # validate remote
        validate_remote

        # download before upload to avoid force overwrite
        download_repo || init_repo

        # push into local git server
        REF_BEFORE=$(env -u GIT_DIR -u GIT_WORK_TREE git -C "$CACHE_DIR" rev-parse refs/heads/main 2>/dev/null || echo "")
        log "- Pushing to local git bare repo at '$CACHE_DIR'..."
        git-receive-pack "$CACHE_DIR"
        REF_AFTER=$(env -u GIT_DIR -u GIT_WORK_TREE git -C "$CACHE_DIR" rev-parse refs/heads/main 2>/dev/null || echo "")
        if [ "$REF_BEFORE" = "$REF_AFTER" ]; then
            warn "Ref unchanged, nothing to upload."
            exit 0
        fi

        # upload
        upload_repo

        exit 0
        ;;
    "connect git-upload-pack"*)
        echo

        # validate remote
        validate_remote

        # download
        download_repo || exit 1

        # pull from local git server
        log "- Pulling from local git bare repo at '$CACHE_DIR'"
        git-upload-pack "$CACHE_DIR"

        exit 0
        ;;
    *)
        log "Unknown message: [$line]"
        exit 1
        ;;
    esac
done
