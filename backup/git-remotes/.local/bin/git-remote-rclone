#!/usr/bin/env python
#
# Script to use rclone as a pseudo git remote
#
# How to use:
# - place this script into any directory in PATH
# - indicate the remote as `rclone::<REPO_URL>`
# - now rclone is kinda like a git server!
#
# Rclone config file encryption:
# - run `secret-tool store --label="Rclone config password" service rclone-config-password` to use OS secret service
# - or handle it manually using `RCLONE_PASSWORD_COMMAND` to retrieve the password


import atexit
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
from pathlib import Path


### COMUNICATION ###
def send(msg: str):
    print(f"{msg}", end="", flush=True, file=sys.stdout)


def log(msg: str, kind: str = "info", exit_code: int | None = None, end=None):
    color = ""
    prefix = ""
    clear = "\x1b[0m"
    # detect text color
    match kind:
        case "none":
            color = ""
            prefix = ""
            clear = ""
        case "info":
            color = "\x1b[1;30m"
            prefix = "LOG: "
        case "note":
            color = "\x1b[1;34m"
            prefix = "NOTE: "
        case "warning":
            color = "\x1b[1;33m"
            prefix = "WARNING: "
        case "error":
            color = "\x1b[1;31m"
            prefix = "ERROR: "
        case _:
            raise ValueError(f"Invalid log kind: {kind}")
    # log message
    print(f"{color}{prefix}{msg}{clear}", file=sys.stderr, flush=True, end=end)
    # early quit
    if exit_code is not None:
        sys.exit(exit_code)


def warn(msg: str, **kwargs):
    log(msg, "warning", **kwargs)


def err_quit(msg: str, **kwargs):
    kwargs.setdefault("exit_code", 1)
    log(msg, "error", **kwargs)


def note(msg: str, **kwargs):
    log(msg, "note", **kwargs)


def question(msg: str) -> bool:
    log(f"{msg} [y/n] ", "none", end="")
    result = cmd(
        ['read answer </dev/tty; [ "$answer" = "y" ]'],
        shell=True,  # we need some shell magic here since git eats stdin and stdout!
        check=False,
    )
    return result.returncode == 0


### SUBPROCESSES ###
def cmd(params: list[str], **kwargs) -> subprocess.CompletedProcess:
    kwargs.setdefault("stdin", subprocess.DEVNULL)
    kwargs.setdefault("stdout", sys.stderr)
    kwargs.setdefault("check", True)
    return subprocess.run(params, **kwargs)  # noqa: PLW1510


def cmd_git_init(dst: str):
    cmd(
        ["git", "init", "--bare", dst],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def cmd_git_clone(src: str, dst: str):
    cmd(
        ["git", "clone", "--bare", src, dst],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def cmd_git_refs(git_dir: str) -> str:
    env = os.environ.copy()
    env.pop("GIT_DIR", None)
    return cmd(
        ["git", "for-each-ref", "--sort=refname", "--format=%(refname) %(objectname)"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=env,
        cwd=git_dir,
    ).stdout.strip()


def cmd_git_bundle(git_dir: str, bundle_file: str):
    env = os.environ.copy()
    env.pop("GIT_DIR", None)
    cmd(
        ["git", "bundle", "create", bundle_file, "--all"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env,
        cwd=git_dir,
    )


def cmd_git_upload_pack(local_server_dir: str):
    cmd(["git-upload-pack", local_server_dir], stdin=None, stdout=None)


def cmd_git_receive_pack(local_server_dir: str):
    cmd(["git-receive-pack", local_server_dir], stdin=None, stdout=None)


def cmd_rclone_listremotes() -> list[str]:
    return cmd(
        ["rclone", "listremotes"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    ).stdout.splitlines()


def cmd_rclone_url_exist(remote_url: str) -> bool:
    result = cmd(
        ["rclone", "lsf", remote_url],
        stderr=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        check=False,
    )
    if {"bundle", "hash"}.issubset(set(result.stdout.splitlines())):
        err_quit("Remote is not a valid Git repository!")

    match result.returncode:
        case 0:
            return True
        case 3:
            return False
        case _:
            err_quit("Unable to check remote status!")
            return False  # shush linter


def cmd_rclone_copy(src: str, dst: str):
    cmd(["rclone", "copyto", src, dst])


def cmd_rclone_sync(src: str, dst: str):
    cmd(["rclone", "sync", "--ignore-times", src, dst])


### FILE OPERATIONS ###
def file_hash(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def exists_not_empty(path: str) -> bool:
    return (p := Path(path)) and p.exists() and p.stat().st_size > 0


### GIT REMOTE ###
class GitRemote:
    def __init__(self, remote_url: str):
        self.remote_url: str = remote_url.rstrip("/")
        self.remote_name: str = f"{self.remote_url.split(':')[0]}:"
        self.remote_bundle: str = f"{remote_url}/bundle"
        self.remote_hash: str = f"{remote_url}/hash"

        # local paths
        self.local_dir: str = str(Path.cwd())

        # local working directory
        self.rclone_dir: str = str((Path(os.environ["GIT_DIR"]) / "rclone").resolve())
        self.rclone_repo_dir: str = str(Path(self.rclone_dir) / "repo")
        self.rclone_bundle: str = str(Path(self.rclone_repo_dir) / "bundle")
        self.rclone_hash: str = str(Path(self.rclone_repo_dir) / "hash")
        Path(self.rclone_repo_dir).mkdir(parents=True, exist_ok=True)
        Path(self.rclone_bundle).touch()
        Path(self.rclone_hash).touch()

        # temporary directory for temporary files
        qurl = urllib.parse.quote(self.remote_url, safe="._-")
        tmp_root_dir = Path(tempfile.gettempdir()) / "git-remote-rclone"
        tmp_root_dir.mkdir(parents=True, exist_ok=True)
        self.tmp_dir: str = tempfile.mkdtemp(prefix=qurl, dir=tmp_root_dir)
        os.chmod(self.tmp_dir, 0o700)
        atexit.register(shutil.rmtree, self.tmp_dir, ignore_errors=True)

        # shared tmp file/dirs
        self.tmp_server_dir: str = self.new_tmp_dir()

    def new_tmp_file(self) -> str:
        return tempfile.NamedTemporaryFile(dir=self.tmp_dir, delete=False).name

    def new_tmp_dir(self) -> str:
        return tempfile.mkdtemp(dir=self.tmp_dir)

    def download_rclone_remote(self):
        log("Downloading remote hash...")
        cmd_rclone_copy(self.remote_hash, self.rclone_hash)

        if exists_not_empty(self.rclone_bundle):
            lhash = file_hash(self.rclone_bundle)
            rhash = Path(self.rclone_hash).read_text().strip()
            if lhash == rhash:
                note("Skipping download of remote bundle as it matches local bundle!")
            else:
                log("Downloading remote bundle...")
                cmd_rclone_copy(self.remote_bundle, self.rclone_bundle)

                log("Validating downloaded bundle...")
                if file_hash(self.rclone_bundle) != rhash:
                    err_quit("Downloaded bundle has invalid hash!")

        cmd_git_clone(self.rclone_bundle, self.tmp_server_dir)

    def upload_rclone_remote(self):
        log("Uploading files to remote...")
        cmd_rclone_sync(self.rclone_repo_dir, self.remote_url)

    def communicate(self):
        # validate rclone is available
        if shutil.which("rclone") is None:
            err_quit("Rclone command is not in PATH!")

        # validate rclone remote is available
        log("Validating rclone remote is valid...")
        if self.remote_name not in cmd_rclone_listremotes():
            err_quit(f"Unknown rclone remote: {self.remote_name}")

        # comunicate with git
        assert sys.stdin.readline().split() == ["capabilities"]
        send("connect\n\n")

        line = sys.stdin.readline()
        send("\n")

        match line.split():
            # git push operation
            case ["connect", "git-receive-pack"]:
                if not cmd_rclone_url_exist(self.remote_url):
                    warn(f"Remote url {self.remote_url} does not exist!")
                    if not question("Do you want to create the repository?"):
                        err_quit("No repository to work on!")
                    cmd_git_init(self.tmp_server_dir)
                else:
                    self.download_rclone_remote()

                log("Receiving packs into local server...")
                prev_refs = cmd_git_refs(self.tmp_server_dir)
                cmd_git_receive_pack(self.tmp_server_dir)
                after_refs = cmd_git_refs(self.tmp_server_dir)
                if prev_refs == after_refs:
                    note("Refs didn't change, early quitting!", exit_code=0)

                self.upload_rclone_remote()

            # git pull operation
            case ["connect", "git-upload-pack"]:
                if not cmd_rclone_url_exist(self.remote_url):
                    err_quit(f"Remote url {self.remote_url} does not exist!")

                self.download_rclone_remote()

                log("Uploading packs from local server...")
                cmd_git_upload_pack(self.tmp_server_dir)

            case _:
                err_quit(f"Invalid line received: {line}")


### EXECUTION ###
if __name__ == "__main__":
    if len(sys.argv) != 3:
        err_quit("Usage: git-remote-rclone REMOTE_NAME REMOTE_URL")

    # setup default for env vars
    os.environ.setdefault("RCLONE_PROGRESS", "true")
    os.environ.setdefault("RCLONE_ASKPASSWORD", "false")
    if shutil.which("secret-tool"):
        os.environ.setdefault(
            "RCLONE_PASSWORD_COMMAND",
            "secret-tool lookup service rclone-config-password",
        )

    GitRemote(sys.argv[2]).communicate()
