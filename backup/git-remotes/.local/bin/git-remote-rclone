#!/usr/bin/env python
#
# Script to use rclone as a pseudo git remote
#
# How to use:
# - place this script into any directory in PATH
# - indicate the remote as `rclone::<REPO_URL>`
# - now rclone is kinda like a git server!
#
# Rclone config file encryption:
# - run `secret-tool store --label="Rclone config password" service rclone-config-password` to use OS secret service
# - or handle it manually using `RCLONE_PASSWORD_COMMAND` to retrieve the password


import atexit
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
from pathlib import Path


### COMUNICATION ###
def send(msg: str):
    print(f"{msg}", end="", flush=True, file=sys.stdout)


def log(msg: str, kind: str = "info", exit_code: int | None = None, end=None):
    color = ""
    prefix = ""
    clear = "\x1b[0m"
    # detect text color
    match kind:
        case "none":
            color = ""
            prefix = ""
            clear = ""
        case "info":
            color = "\x1b[1;37m"
            prefix = "- "
        case "warning":
            color = "\x1b[1;33m"
            prefix = "WARNING: "
        case "error":
            color = "\x1b[1;31m"
            prefix = "ERROR: "
        case _:
            raise ValueError(f"Invalid log kind: {kind}")
    # log message
    print(f"{color}{prefix}{msg}{clear}", file=sys.stderr, flush=True, end=end)
    # early quit
    if exit_code is not None:
        sys.exit(exit_code)


def warn(msg: str):
    log(msg, "warning")


def err_quit(msg: str):
    log(msg, "error", 1)


def question(msg: str) -> bool:
    log(f"{msg} [y/n] ", "none", end="")
    result = cmd(
        ['read answer </dev/tty; [ "$answer" = "y" ]'],
        shell=True,  # we need some shell magic here since git eats stdin and stdout!
        check=False,
    )
    return result.returncode == 0


### SUBPROCESSES ###
def cmd(params: list[str], **kwargs) -> subprocess.CompletedProcess:
    kwargs.setdefault("check", True)
    kwargs.setdefault("stdout", sys.stderr)
    kwargs.setdefault("stdin", subprocess.DEVNULL)
    return subprocess.run(params, **kwargs)  # noqa: PLW1510


def cmd_out(params: list[str], **kwargs) -> subprocess.CompletedProcess:
    kwargs.setdefault("stdout", subprocess.PIPE)
    kwargs.setdefault("text", True)
    return cmd(params, **kwargs)


def cmd_git_clone(src: str, dst: str):
    shutil.rmtree(dst)
    cmd(["git", "clone", "--bare", src, dst])


def cmd_git_refs(git_dir: str, refs_file: str):
    env = os.environ.copy()
    env.pop("GIT_DIR", None)
    refs = cmd_out(
        ["git", "for-each-ref", "--sort=refname", "--format=%(refname) %(objectname)"],
        env=env,
        cwd=git_dir,
    ).stdout
    Path(refs_file).write_text(refs)


def cmd_git_bundle(git_dir: str, bundle_file: str):
    env = os.environ.copy()
    env.pop("GIT_DIR", None)
    cmd(
        ["git", "bundle", "create", bundle_file, "--all"],
        env=env,
        cwd=git_dir,
    )


def cmd_git_upload_pack(local_server_dir: str):
    cmd(["git-upload-pack", local_server_dir], stdin=None, stdout=None)


def cmd_git_receive_pack(local_server_dir: str):
    cmd(["git-receive-pack", local_server_dir], stdin=None, stdout=None)


def cmd_rclone_listremotes() -> list[str]:
    return cmd_out(["rclone", "listremotes"], check=False).stdout.splitlines()


def cmd_rclone_url_exist(remote_url: str) -> bool:
    result = cmd(["rclone", "lsf", remote_url], check=False)
    match result.returncode:
        case 0:
            return True
        case 3:
            return False
        case _:
            err_quit("Unable to check remote status!")
            return False  # shush linter


def cmd_rclone_copy(src: str, dst: str):
    cmd(["rclone", "copyto", src, dst])


### GIT REMOTE ###
class GitRemote:
    def __init__(self, remote_url: str):
        self.url: str = remote_url.rstrip("/")
        self.name = f"{self.url.split(':')[0]}:"

        # paths on the rclone remote
        self.refs: str = f"{self.url}/refs"
        self.bundle: str = f"{self.url}/bundle"

        # local paths
        self.local_dir: str = str(Path.cwd())

        # temporary directory for temporary files
        qurl = urllib.parse.quote(self.url, safe="._-")
        self.tmp_root_dir = Path(tempfile.gettempdir()) / "git-remote-rclone"
        self.tmp_root_dir.mkdir(parents=True, exist_ok=True)
        os.chmod(self.tmp_root_dir, 0o700)
        self.tmp_dir: str = tempfile.mkdtemp(prefix=qurl, dir=self.tmp_root_dir)
        os.chmod(self.tmp_dir, 0o700)
        self.tmp_server_dir = tempfile.mkdtemp(prefix="git-server", dir=self.tmp_dir)
        self.tmp_refs_file_pull = self.new_tmp_file()
        self.tmp_refs_file_push = self.new_tmp_file()
        atexit.register(shutil.rmtree, self.tmp_dir, ignore_errors=True)

    def new_tmp_file(self):
        return tempfile.NamedTemporaryFile(dir=self.tmp_dir, delete=False).name

    def download_rclone_remote(self, prompt: bool):
        # if remote url is missing, and requested, prompt to create new repo
        remote_exists = cmd_rclone_url_exist(self.url)
        if not remote_exists:
            if prompt:
                warn(f"Remote url {self.url} does not exist!")
                if not question("Do you want to create the repository on the remote?"):
                    err_quit("No repository to work on!")
            else:
                err_quit(f"Remote url {self.url} does not exist!")

        # initialize local server
        log("Using local repo to create a local server repository...")
        cmd_git_clone(self.local_dir, self.tmp_server_dir)

        if remote_exists:
            # compare remote refs with local refs to see if history differ
            log("Downloading refs from remote...")
            cmd_rclone_copy(self.refs, self.tmp_refs_file_pull)
            cmd_git_refs(self.tmp_server_dir, self.tmp_refs_file_push)
            remote_refs = Path(self.tmp_refs_file_pull).read_text().strip()
            local_refs = Path(self.tmp_refs_file_push).read_text().strip()

            # initialize local server directory
            if remote_refs != local_refs:
                remote_bundle_file = self.new_tmp_file()
                log("Downloading bundle from remote...")
                cmd_rclone_copy(self.bundle, remote_bundle_file)
                log("Creating local server repository...")
                cmd_git_clone(remote_bundle_file, self.tmp_server_dir)
            else:
                warn("Nothing to download!")
        else:
            # generate push refs anyway
            cmd_git_refs(self.tmp_server_dir, self.tmp_refs_file_push)

    def upload_remote_rclone(self):
        pull_refs = Path(self.tmp_refs_file_pull).read_text()
        push_refs = Path(self.tmp_refs_file_push).read_text()
        if pull_refs != push_refs:
            log("Creating bundle file")
            local_bundle = self.new_tmp_file()
            cmd_git_bundle(self.tmp_server_dir, local_bundle)
            log("Uploading new bundle file...")
            cmd_rclone_copy(local_bundle, self.bundle)
            log("Uploading new refs file...")
            cmd_rclone_copy(self.tmp_refs_file_push, self.refs)
        else:
            warn("Nothing to upload!")

    def communicate(self):
        # validate rclone is available
        if shutil.which("rclone") is None:
            err_quit("Rclone command is not in PATH!")

        # validate rclone remote is available
        log("Validating rclone remote is valid...")
        if self.name not in cmd_rclone_listremotes():
            err_quit(f"Unknown rclone remote: {self.name}")

        # comunicate with git
        assert sys.stdin.readline().split() == ["capabilities"]
        send("connect\n\n")

        line = sys.stdin.readline()
        send("\n")

        match line.split():
            # git push operation
            case ["connect", "git-receive-pack"]:
                self.download_rclone_remote(True)
                cmd_git_receive_pack(self.tmp_server_dir)
                self.upload_remote_rclone()

            # git pull operation
            case ["connect", "git-upload-pack"]:
                self.download_rclone_remote(False)
                cmd_git_upload_pack(self.tmp_server_dir)

            case _:
                err_quit(f"Invalid line received: {line}")


### EXECUTION ###
if __name__ == "__main__":
    if len(sys.argv) != 3:
        err_quit("Usage: git-remote-rclone REMOTE_NAME REMOTE_URL")

    # setup default for env vars
    os.environ.setdefault("RCLONE_PROGRESS", "true")
    os.environ.setdefault("RCLONE_ASKPASSWORD", "false")
    if shutil.which("secret-tool"):
        os.environ.setdefault(
            "RCLONE_PASSWORD_COMMAND",
            "secret-tool lookup service rclone-config-password",
        )

    GitRemote(sys.argv[2]).communicate()
