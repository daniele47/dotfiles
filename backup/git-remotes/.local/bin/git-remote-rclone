#!/bin/bash

# Script to use rclone as a pseudo git remote
#
# How to use:
# - place this script into any directory in PATH
# - indicate the remote as `rclone::<REPO_NAME>`
# - now rclone is kinda like a git server!
#
# Note: git pull/push download/upload ENTIRE repo!

set -euo pipefail

for dep in rclone git; do
    if ! command -v "$dep" &>/dev/null; then
        echo "Missing required dependency: '$dep'"
    fi
done

log() {
    echo -e "\e[1m$*\e[m" >&2
}

REMOTE_URL="$2"
REPO_NAME="$(basename "$REMOTE_URL")"
CACHE_TOPDIR="${XDG_CACHE_HOME:-HOME/.cache}/git-remote-rclone"
CACHE_DIR="$CACHE_TOPDIR/$REPO_NAME"

run_cli() {
    rclone --progress "$@" >&2
}

upload_repo() {
    {
        log "- Uploading bundle to remote '$REMOTE_URL'..."
        run_cli sync "$CACHE_DIR" "$REMOTE_URL"
    } >&2
}

download_repo() {
    {
        log "- Checking if remote url is already present..."
        if ! run_cli lsf "$REMOTE_URL" &>/dev/null; then
            log "\e[33mWARNING: Remote repo not found, initializing new bare repo at '$CACHE_DIR'..."
            rm -rf "$CACHE_DIR"
            git init --bare "$CACHE_DIR"
            return 0
        fi

        log "- Downloading git bundle from '$REMOTE_URL' into '$CACHE_DIR'..."
        run_cli sync "$REMOTE_URL" "$CACHE_DIR"
    } >&2
}

mkdir -p "$CACHE_TOPDIR"

while IFS= read -r line; do
    case "$line" in
    capabilities)
        echo -e "connect\n"
        ;;
    "connect git-receive-pack"*)
        echo
        # download before upload to avoid force overwrite
        download_repo

        # push into local git server
        REF_BEFORE=$(git -C "$CACHE_DIR" rev-parse refs/heads/main 2>/dev/null || echo "")
        log "- Pushing to local git bare repo at '$CACHE_DIR'..."
        git-receive-pack "$CACHE_DIR"
        REF_AFTER=$(git -C "$CACHE_DIR" rev-parse refs/heads/main 2>/dev/null || echo "")
        if [ "$REF_BEFORE" = "$REF_AFTER" ]; then
            log "\e[33mWARNING: Ref unchanged, nothing to upload."
            exit 0
        fi

        # upload
        upload_repo

        exit 0
        ;;
    "connect git-upload-pack"*)
        echo
        # download
        download_repo

        # pull from local git server
        log "- Pulling from local git bare repo at '$CACHE_DIR'"
        git-upload-pack "$CACHE_DIR"

        exit 0
        ;;
    *)
        log "Unknown message: [$line]"
        exit 1
        ;;
    esac
done
