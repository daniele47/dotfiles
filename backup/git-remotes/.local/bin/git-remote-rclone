#!/usr/bin/env python
#
# Script to use rclone as a pseudo git remote
#
# How to use:
# - place this script into any directory in PATH
# - indicate the remote as `rclone::<REPO_URL>`
# - now rclone is kinda like a git server!
#
# Rclone config file encryption:
# - run `secret-tool store --label="Rclone config password" service rclone-config-password` to use OS secret service
# - or handle it manually using `RCLONE_PASSWORD_COMMAND` to retrieve the password


import os
import shutil
import subprocess
import sys


### UTILITY METHODS ###
class GitRemote:
    def __init__(self, remote_url: str):
        self.url: str = remote_url.rstrip("/")
        self.name = f"{self.url.split(':')[0]}:"
        self.refs: str = f"{self.url}/refs"
        self.bundle: str = f"{self.url}/bundle"


def send(msg: str):
    print(f"{msg}", end="", flush=True, file=sys.stdout)


def log(msg: str, kind: str = "info", exit_code: int | None = None):
    color = ""
    prefix = ""
    clear = "\x1b[0m"
    # detect text color
    match kind:
        case "info":
            color = "\x1b[1;37m"
            prefix = "- "
        case "warning":
            color = "\x1b[1;33m"
            prefix = "WARNING: "
        case "error":
            color = "\x1b[1;31m"
            prefix = "ERROR: "
        case _:
            raise ValueError(f"Invalid log kind: {kind}")
    # log message
    print(f"{color}{prefix}{msg}{clear}", file=sys.stderr, flush=True)
    # early quit
    if exit_code is not None:
        sys.exit(exit_code)


def rclone_cmd(params: list[str], **kwargs):
    kwargs.setdefault("check", False)
    kwargs.setdefault("text", True)
    kwargs.setdefault("capture_output", False)
    return subprocess.run(["rclone", "--ask-password=false", *params], **kwargs)  # noqa: PLW1510


def validate_rclone_remote(git_remote: GitRemote):
    # validate rclone is available
    if shutil.which("rclone") is None:
        log("Rclone command is not in PATH!", "error", 1)

    # validate rclone remote is available
    result = rclone_cmd(["listremotes"], stdout=subprocess.PIPE)
    if git_remote.name not in result.stdout.splitlines():
        log(f"Unknown rclone remote: {git_remote.name}", "error", 1)


### EXECUTION ###
if __name__ == "__main__":
    if len(sys.argv) != 3:
        log("Usage: git-remote-rclone REMOTE_NAME REMOTE_URL", "error", 1)

    # provide a default to unlock rclone config
    if shutil.which("secret-tool"):
        os.environ.setdefault(
            "RCLONE_PASSWORD_COMMAND",
            "secret-tool lookup service rclone-config-password",
        )

    # read parameters
    git_remote = GitRemote(sys.argv[2])

    # validate remote
    validate_rclone_remote(git_remote)

    for line in sys.stdin:
        line = line.rstrip("\n")

        match line.split():
            case ["capabilities"]:
                send("connect\n\n")

            case ["connect", "git-receive-pack"]:
                sys.exit(7)

            case ["connect", "git-upload-pack"]:
                sys.exit(7)

            case _:
                log(f"Invalid line received: {line}", "error", 1)
