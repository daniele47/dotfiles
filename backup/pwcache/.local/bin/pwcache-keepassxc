#!/bin/bash

set -euo pipefail

# validate deps
for dep in keyctl pwcache; do
    if ! command -v "$dep" &>/dev/null; then
        echo "Missing required dependency: '$dep'" >&2
        exit 1
    fi
done

# validate params
if [[ "$#" -lt 3 ]]; then
    echo "Script requires 3 or more parameters: PROMPT_CMD... -- KEEPASSXC_ARGS..."
    exit 1
fi

# parameters
PROMPT_CMD=()
KEEPASSXC_ARGS=()
TIMEOUT="600"
KEY_NAME="keepassxc-vault"
found_separator=false
for ARG in "$@"; do
    if [[ "$found_separator" == false && "$ARG" == "--" ]]; then
        found_separator=true
        continue
    fi
    if [[ "$found_separator" == false ]]; then
        PROMPT_CMD+=("$ARG")
    else
        KEEPASSXC_ARGS+=("$ARG")
    fi
done
if [[ "$found_separator" == false ]]; then
    echo "No -- separator found!" >&2
    exit 1
fi

# detect keepassxc-cli
if command -v keepassxc-cli &>/dev/null; then
    KEEPASSXC=(keepassxc-cli)
elif flatpak info org.keepassxc.KeePassXC &>/dev/null; then
    KEEPASSXC=(flatpak run --command=keepassxc-cli org.keepassxc.KeePassXC)
else
    echo "Keepassxc-cli not installed neither normally nor as a flatpak!" >&2
    exit 1
fi

# execute keepassxc-cli command
pwcache "$KEY_NAME" "$TIMEOUT" "${PROMPT_CMD[@]}" | "${KEEPASSXC[@]}" "${KEEPASSXC_ARGS[@]}"
