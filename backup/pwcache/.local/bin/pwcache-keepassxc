#!/bin/bash

set -euo pipefail

# validate deps
for dep in keyctl pwcache; do
    if ! command -v "$dep" &>/dev/null; then
        echo "Missing required dependency: '$dep'" >&2
        exit 1
    fi
done

# validate params
if [[ "$#" -lt 2 ]]; then
    echo "Script requires 1 or more parameters: PROMPT_CMD KEEPASSXC_ARGS..."
    exit 1
fi

# parameters
PROMPT_CMD="$1"
KEEPASSXC_ARGS=("${@:2}")
TIMEOUT="600"
KEY_NAME="keepassxc-vault"

# detect keepassxc-cli
if command -v keepassxc-cli &>/dev/null; then
    KEEPASSXC=(keepassxc-cli)
elif flatpak info org.keepassxc.KeePassXC &>/dev/null; then
    KEEPASSXC=(flatpak run --command=keepassxc-cli org.keepassxc.KeePassXC)
else
    echo "Keepassxc-cli not installed neither normally nor as a flatpak!" >&2
    exit 1
fi

# execute keepassxc-cli command
pwcache "$KEY_NAME" "$PROMPT_CMD" "$TIMEOUT" | "${KEEPASSXC[@]}" "${KEEPASSXC_ARGS[@]}"
