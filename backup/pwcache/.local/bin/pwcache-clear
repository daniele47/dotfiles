#!/bin/bash

set -euo pipefail

# validate deps
for dep in keyctl; do
    if ! command -v "$dep" &>/dev/null; then
        echo "Missing required dependency: '$dep'" >&2
        exit 1
    fi
done

# validate params
if [[ "$#" -gt 0 ]]; then
    echo "Script requires no parameters"
    exit 1
fi

keyctl clear @s
